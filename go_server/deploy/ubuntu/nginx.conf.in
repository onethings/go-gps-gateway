# Installed as /etc/nginx/sites-available/traccar-gateway by install.sh.
# nginx terminates TLS and proxies everything to the gateway, which already
# serves the traccar-web build (including the SPA fallback) and the WebSocket.
# Proxying instead of serving files from /opt avoids the AppArmor profile that
# ships with Ubuntu's nginx package. Run certbot --nginx afterwards for TLS.
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    # Device images and other uploads go through /api/server/file/.
    client_max_body_size 32m;

    # Prometheus metrics stay local; add "allow <your-ip>;" above the deny to
    # scrape this from another host.
    location = /metrics {
        allow 127.0.0.1;
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long lived /api/socket connections.
        proxy_read_timeout 300s;
    }
}
